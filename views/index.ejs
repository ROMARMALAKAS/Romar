<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LoveConnect - Find Your Match</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *{box-sizing:border-box}
        body{font-family:'Inter',sans-serif;margin:0;background:#fff}
        .hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px}
        .hero-content{max-width:400px}
        .hero-logo{width:70px;height:70px;background:#2563eb;border-radius:18px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:24px}
        .hero-logo i{color:#fff;font-size:2rem}
        .hero h1{font-weight:800;font-size:1.8rem;color:#222;margin-bottom:10px}
        .hero p{color:#888;font-size:0.95rem;margin-bottom:32px;line-height:1.5}
        .btn-start{display:block;width:100%;padding:14px;border:none;background:#2563eb;color:#fff;border-radius:10px;font-weight:600;font-size:0.95rem;text-decoration:none;text-align:center;margin-bottom:12px}
        .btn-start:hover{background:#1d4ed8;color:#fff}
        .btn-signin{display:block;width:100%;padding:14px;border:1px solid #e8e8e8;background:#fff;color:#333;border-radius:10px;font-weight:500;font-size:0.95rem;text-decoration:none;text-align:center}
        .btn-signin:hover{background:#f8f9fa;color:#333}
        .stats{display:flex;justify-content:center;gap:30px;margin-top:40px}
        .stats .stat{text-align:center}
        .stats .stat .num{font-weight:700;font-size:1.2rem;color:#222}
        .stats .stat .label{font-size:0.75rem;color:#888}
    </style>
</head>
<body>
    <section class="hero">
        <div class="hero-content">
            <div class="hero-logo"><i class="bi bi-heart-fill"></i></div>
            <h1>Find Your Perfect Match</h1>
            <p>Connect with amazing people near you. Start your love story today.</p>
            <a href="/register" class="btn-start"><i class="bi bi-heart-fill me-2"></i>Get Started</a>
            <a href="/login" class="btn-signin"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</a>
            <div class="stats">
                <div class="stat"><div class="num">10K+</div><div class="label">Users</div></div>
                <div class="stat"><div class="num">5K+</div><div class="label">Matches</div></div>
                <div class="stat"><div class="num">98%</div><div class="label">Happy</div></div>
            </div>
        </div>
    </section>
</body>
</html>
