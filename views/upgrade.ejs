<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upgrade - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body{font-family:'Poppins',sans-serif;background:#f8f9fa}
        .navbar-dating{background:linear-gradient(135deg,#e91e63,#ff5252)}
        .navbar-dating .navbar-brand,.navbar-dating .nav-link{color:white!important;font-weight:600}
        .plan-card{border:none;border-radius:20px;box-shadow:0 5px 25px rgba(0,0,0,0.08);transition:all 0.3s}
        .plan-card:hover{transform:translateY(-5px);box-shadow:0 10px 40px rgba(0,0,0,0.12)}
        .plan-card.featured{border:2px solid #e91e63!important}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dating sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/dashboard"><i class="bi bi-heart-fill me-2"></i>LoveConnect</a>
            <a class="nav-link text-white" href="/dashboard"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </nav>
    <div class="container py-5">
        <div class="text-center mb-5"><h2 class="fw-bold">Upgrade to Premium</h2><p class="text-muted">Unlock all features and find your match faster</p></div>
        <div class="row justify-content-center g-4">
            <div class="col-md-5 col-lg-4">
                <div class="card plan-card h-100 text-center p-4">
                    <i class="bi bi-person-circle fs-1 text-muted"></i>
                    <h4 class="fw-bold mt-3">Free</h4>
                    <h2 class="fw-bold text-muted">$0<small class="fs-6">/mo</small></h2>
                    <hr>
                    <ul class="list-unstyled text-start">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>View profiles</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Send messages</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>See distance</li>
                        <li class="mb-2"><i class="bi bi-x-circle-fill text-danger me-2"></i>Send photos</li>
                        <li class="mb-2"><i class="bi bi-x-circle-fill text-danger me-2"></i>Priority visibility</li>
                    </ul>
                    <button class="btn btn-outline-secondary rounded-pill mt-auto" disabled>Current Plan</button>
                </div>
            </div>
            <div class="col-md-5 col-lg-4">
                <div class="card plan-card featured h-100 text-center p-4">
                    <span class="badge bg-danger rounded-pill mb-2 mx-auto px-3">MOST POPULAR</span>
                    <i class="bi bi-star-fill fs-1 text-warning"></i>
                    <h4 class="fw-bold mt-3">Premium</h4>
                    <h2 class="fw-bold" style="color:#e91e63">$9.99<small class="fs-6">/mo</small></h2>
                    <hr>
                    <ul class="list-unstyled text-start">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>View profiles</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Send messages</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>See distance</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Send photos</strong></li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Priority visibility</strong></li>
                    </ul>
                    <button class="btn btn-danger rounded-pill mt-auto fw-bold" onclick="alert('Contact admin to upgrade your account!')"><i class="bi bi-star-fill me-2"></i>Upgrade Now</button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
