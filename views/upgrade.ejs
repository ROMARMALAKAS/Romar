<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upgrade - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *{box-sizing:border-box}
        body{font-family:'Inter',sans-serif;background:#fff;margin:0;padding-bottom:70px}
        .top-header{background:#fff;padding:16px 20px;border-bottom:1px solid #f0f0f0;position:sticky;top:0;z-index:100}
        .top-header h6{margin:0;font-weight:600;color:#333}
        .upgrade-section{padding:30px 20px;text-align:center}
        .upgrade-section h4{font-weight:700;color:#222;margin-bottom:6px}
        .upgrade-section p{color:#888;font-size:0.85rem}
        .plan-card{border:1px solid #e8e8e8;border-radius:16px;padding:24px 20px;margin-bottom:16px;text-align:center}
        .plan-card.featured{border:2px solid #2563eb}
        .plan-card .plan-name{font-weight:600;font-size:1rem;color:#222;margin-top:10px}
        .plan-card .plan-price{font-weight:700;font-size:1.5rem;color:#222;margin:8px 0}
        .plan-card .plan-price small{font-size:0.8rem;font-weight:400;color:#888}
        .plan-card ul{list-style:none;padding:0;text-align:left;margin:16px 0}
        .plan-card ul li{padding:6px 0;font-size:0.85rem;color:#555}
        .plan-card ul li i{margin-right:8px}
        .btn-upgrade{width:100%;padding:12px;border:none;background:#2563eb;color:#fff;border-radius:10px;font-weight:600;font-size:0.9rem}
        .btn-upgrade:hover{background:#1d4ed8}
        .btn-current{width:100%;padding:12px;border:1px solid #e8e8e8;background:#f8f9fa;color:#888;border-radius:10px;font-weight:500;font-size:0.9rem}
        .bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #f0f0f0;display:flex;justify-content:space-around;align-items:center;padding:8px 0 12px;z-index:1000}
        .bottom-nav a{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#999;font-size:0.7rem;font-weight:500;padding:4px 12px;border-radius:12px;transition:all 0.2s}
        .bottom-nav a.active{color:#2563eb;background:#eff6ff}
        .bottom-nav a i{font-size:1.3rem;margin-bottom:2px}
        .confirm-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:2000;align-items:center;justify-content:center}
        .confirm-overlay.show{display:flex}
        .confirm-box{background:#fff;border-radius:16px;padding:30px 24px;text-align:center;max-width:320px;width:90%;box-shadow:0 10px 40px rgba(0,0,0,0.15)}
        .confirm-box h5{font-weight:600;margin-bottom:8px;color:#222}
        .confirm-box p{font-size:0.85rem;color:#888;margin-bottom:20px}
        .confirm-box .btn-confirm{width:100%;padding:12px;border:none;background:#2563eb;color:#fff;border-radius:10px;font-weight:600;margin-bottom:8px}
        .confirm-box .btn-cancel{width:100%;padding:12px;border:1px solid #e8e8e8;background:#fff;color:#333;border-radius:10px;font-weight:500}
    </style>
</head>
<body>
    <div class="top-header">
        <h6><i class="bi bi-star me-2"></i>Upgrade Plan</h6>
    </div>

    <div class="upgrade-section">
        <h4>Choose Your Plan</h4>
        <p>Unlock all features and find your match faster</p>
    </div>

    <div class="px-3">
        <div class="plan-card">
            <i class="bi bi-person-circle" style="font-size:2rem;color:#888"></i>
            <div class="plan-name">Free</div>
            <div class="plan-price">$0<small>/mo</small></div>
            <ul>
                <li><i class="bi bi-check-circle-fill text-success"></i>View profiles</li>
                <li><i class="bi bi-check-circle-fill text-success"></i>Send messages</li>
                <li><i class="bi bi-check-circle-fill text-success"></i>See distance</li>
                <li><i class="bi bi-x-circle-fill text-danger"></i>Send photos</li>
                <li><i class="bi bi-x-circle-fill text-danger"></i>Priority visibility</li>
            </ul>
            <button class="btn-current" disabled>Current Plan</button>
        </div>

        <div class="plan-card featured">
            <span class="badge bg-primary rounded-pill mb-2" style="font-size:0.7rem">RECOMMENDED</span>
            <i class="bi bi-star-fill" style="font-size:2rem;color:#f59e0b"></i>
            <div class="plan-name">Premium</div>
            <div class="plan-price">$9.99<small>/mo</small></div>
            <ul>
                <li><i class="bi bi-check-circle-fill text-success"></i>View profiles</li>
                <li><i class="bi bi-check-circle-fill text-success"></i>Send messages</li>
                <li><i class="bi bi-check-circle-fill text-success"></i>See distance</li>
                <li><i class="bi bi-check-circle-fill text-success"></i><strong>Send photos</strong></li>
                <li><i class="bi bi-check-circle-fill text-success"></i><strong>Priority visibility</strong></li>
            </ul>
            <button class="btn-upgrade" onclick="showConfirm()"><i class="bi bi-star-fill me-2"></i>Upgrade Now</button>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-box">
            <i class="bi bi-star-fill" style="font-size:2.5rem;color:#f59e0b"></i>
            <h5 class="mt-3">Upgrade to Premium?</h5>
            <p>You will be upgraded to Premium for $9.99/mo. Enjoy all features including photo sending and priority visibility.</p>
            <button class="btn-confirm" onclick="confirmUpgrade()">Yes, Upgrade My Account</button>
            <button class="btn-cancel" onclick="hideConfirm()">Cancel</button>
        </div>
    </div>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
        <a href="/dashboard"><i class="bi bi-house-fill"></i>Home</a>
        <a href="/upgrade" class="active"><i class="bi bi-plus-circle"></i>Upgrade</a>
        <a href="/profile"><i class="bi bi-clock-history"></i>Profile</a>
        <a href="/chat"><i class="bi bi-chat-dots"></i>Chats</a>
        <a href="/profile"><i class="bi bi-person-circle"></i>Account</a>
    </nav>

    <script>
    function showConfirm(){document.getElementById('confirmOverlay').classList.add('show')}
    function hideConfirm(){document.getElementById('confirmOverlay').classList.remove('show')}
    function confirmUpgrade(){alert('Contact admin to upgrade your account!');hideConfirm()}
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
