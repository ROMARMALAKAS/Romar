<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *{box-sizing:border-box}
        body{font-family:'Inter',sans-serif;background:#fff;margin:0;padding-bottom:70px}
        .top-header{background:#fff;padding:16px 20px;border-bottom:1px solid #f0f0f0;position:sticky;top:0;z-index:100}
        .top-header h6{margin:0;font-weight:600;color:#333}
        .profile-section{padding:20px}
        .avatar-wrap{text-align:center;margin-bottom:20px}
        .avatar-wrap img{width:80px;height:80px;border-radius:50%;border:3px solid #f0f0f0}
        .avatar-wrap h5{font-weight:600;margin-top:10px;margin-bottom:2px;color:#222}
        .avatar-wrap .badge-type{font-size:0.75rem;padding:4px 12px;border-radius:12px;font-weight:500}
        .avatar-wrap .badge-type.premium{background:#fff3cd;color:#856404}
        .avatar-wrap .badge-type.free{background:#f0f0f0;color:#666}
        .form-section{padding:0 20px}
        .form-section label{font-weight:500;font-size:0.85rem;color:#555;margin-bottom:4px}
        .form-section .form-control{border:1px solid #e8e8e8;border-radius:10px;padding:10px 14px;font-size:0.9rem}
        .form-section .form-control:focus{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,0.1)}
        .btn-save{width:100%;padding:12px;border:none;background:#2563eb;color:#fff;border-radius:10px;font-weight:600;font-size:0.9rem;margin-top:16px}
        .btn-save:hover{background:#1d4ed8}
        .btn-logout{width:100%;padding:12px;border:1px solid #e8e8e8;background:#fff;color:#dc3545;border-radius:10px;font-weight:500;font-size:0.9rem;margin-top:10px}
        .btn-logout:hover{background:#fef2f2}
        .bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #f0f0f0;display:flex;justify-content:space-around;align-items:center;padding:8px 0 12px;z-index:1000}
        .bottom-nav a{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#999;font-size:0.7rem;font-weight:500;padding:4px 12px;border-radius:12px;transition:all 0.2s}
        .bottom-nav a.active{color:#2563eb;background:#eff6ff}
        .bottom-nav a i{font-size:1.3rem;margin-bottom:2px}
    </style>
</head>
<body>
    <div class="top-header">
        <h6><i class="bi bi-person-circle me-2"></i>Account</h6>
    </div>

    <div class="profile-section">
        <div class="avatar-wrap">
            <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&size=80&background=e8e8e8&color=555&bold=true" alt="Profile">
            <h5><%= user.name %></h5>
            <span class="badge-type <%= user.account_type === 'premium' ? 'premium' : 'free' %>"><%= user.account_type === 'premium' ? 'Premium' : 'Free' %> Account</span>
        </div>

        <% if (error) { %><div class="alert alert-danger py-2 px-3" style="border-radius:10px;font-size:0.85rem"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success py-2 px-3" style="border-radius:10px;font-size:0.85rem"><%= success %></div><% } %>

        <form method="POST" action="/profile">
            <div class="form-section">
                <div class="row g-2 mb-3">
                    <div class="col-8">
                        <label>Full Name</label>
                        <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
                    </div>
                    <div class="col-4">
                        <label>Age</label>
                        <input type="number" name="age" class="form-control" min="18" value="<%= user.age %>" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label>Gender</label>
                    <select name="gender" class="form-control" required>
                        <option value="male" <%= user.gender==='male'?'selected':'' %>>Male</option>
                        <option value="female" <%= user.gender==='female'?'selected':'' %>>Female</option>
                        <option value="other" <%= user.gender==='other'?'selected':'' %>>Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label>Bio</label>
                    <textarea name="bio" class="form-control" rows="3"><%= user.bio %></textarea>
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input type="email" class="form-control" value="<%= user.email %>" disabled style="background:#f8f9fa">
                </div>
                <button type="submit" class="btn-save"><i class="bi bi-check-circle me-2"></i>Save Changes</button>
            </div>
        </form>
        <div class="form-section">
            <a href="/logout" class="btn-logout d-block text-center text-decoration-none"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
        </div>
    </div>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
        <a href="/dashboard"><i class="bi bi-house-fill"></i>Home</a>
        <a href="/upgrade"><i class="bi bi-plus-circle"></i>Upgrade</a>
        <a href="/profile"><i class="bi bi-clock-history"></i>Profile</a>
        <a href="/chat"><i class="bi bi-chat-dots"></i>Chats</a>
        <a href="/profile" class="active"><i class="bi bi-person-circle"></i>Account</a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
