<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body{font-family:'Poppins',sans-serif;background:#f8f9fa}
        .navbar-admin{background:linear-gradient(135deg,#1a237e,#3949ab);box-shadow:0 2px 15px rgba(26,35,126,0.3)}
        .navbar-admin .navbar-brand,.navbar-admin .nav-link{color:white!important;font-weight:600}
        .stat-card{border:none;border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,0.06);transition:all 0.3s}
        .stat-card:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(0,0,0,0.1)}
        .stat-icon{width:55px;height:55px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem}
        .table-card{border:none;border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,0.06)}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-admin sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-shield-fill me-2"></i>Admin Panel</a>
            <a class="nav-link text-white" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
        </div>
    </nav>
    <div class="container py-4">
        <h3 class="fw-bold mb-4">Dashboard Overview</h3>
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3"><i class="bi bi-people-fill"></i></div>
                        <div><h4 class="fw-bold mb-0"><%= totalUsers %></h4><small class="text-muted">Total Users</small></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3"><i class="bi bi-star-fill"></i></div>
                        <div><h4 class="fw-bold mb-0"><%= premiumUsers %></h4><small class="text-muted">Premium</small></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success bg-opacity-10 text-success me-3"><i class="bi bi-person-fill"></i></div>
                        <div><h4 class="fw-bold mb-0"><%= freeUsers %></h4><small class="text-muted">Free</small></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger me-3"><i class="bi bi-chat-fill"></i></div>
                        <div><h4 class="fw-bold mb-0"><%= totalMessages %></h4><small class="text-muted">Messages</small></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card table-card">
            <div class="card-header bg-white p-3 border-0"><h5 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Registered Users</h5></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>User</th><th>Email</th><th>Gender</th><th>Age</th><th>Type</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <% if (users.length === 0) { %>
                                <tr><td colspan="6" class="text-center py-4 text-muted">No users registered yet.</td></tr>
                            <% } else { %>
                                <% users.forEach(u => { %>
                                <tr>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&size=35&background=e91e63&color=fff" class="rounded-circle me-2" style="width:35px;height:35px">
                                            <strong><%= u.name %></strong>
                                        </div>
                                    </td>
                                    <td class="align-middle"><%= u.email %></td>
                                    <td class="align-middle"><%= u.gender %></td>
                                    <td class="align-middle"><%= u.age %></td>
                                    <td class="align-middle">
                                        <span class="badge rounded-pill <%= u.account_type === 'premium' ? 'bg-warning text-dark' : 'bg-secondary' %>"><%= u.account_type %></span>
                                    </td>
                                    <td class="align-middle">
                                        <form method="POST" action="/admin/action" class="d-inline">
                                            <input type="hidden" name="user_id" value="<%= u.id %>">
                                            <% if (u.account_type === 'free') { %>
                                                <button name="action" value="upgrade" class="btn btn-sm btn-warning rounded-pill"><i class="bi bi-arrow-up-circle"></i></button>
                                            <% } else { %>
                                                <button name="action" value="downgrade" class="btn btn-sm btn-secondary rounded-pill"><i class="bi bi-arrow-down-circle"></i></button>
                                            <% } %>
                                            <button name="action" value="delete" class="btn btn-sm btn-danger rounded-pill" onclick="return confirm('Delete this user?')"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
