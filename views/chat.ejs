<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chats - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *{box-sizing:border-box}
        body{font-family:'Inter',sans-serif;background:#fff;margin:0;padding-bottom:70px}
        .top-header{background:#fff;padding:16px 20px;border-bottom:1px solid #f0f0f0;position:sticky;top:0;z-index:100}
        .top-header h6{margin:0;font-weight:600;color:#333}
        .chat-container{height:calc(100vh - 130px)}
        .chat-sidebar{background:#fff;overflow-y:auto;border-right:1px solid #f0f0f0}
        .conv-item{padding:14px 20px;border-bottom:1px solid #f5f5f5;display:flex;align-items:center;text-decoration:none;color:inherit;transition:background 0.2s}
        .conv-item:hover,.conv-item.active{background:#f8f9fa}
        .conv-item img{width:44px;height:44px;border-radius:50%;margin-right:12px}
        .conv-item .name{font-weight:600;font-size:0.9rem;color:#222}
        .conv-item .preview{font-size:0.8rem;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}
        .chat-header{padding:14px 20px;border-bottom:1px solid #f0f0f0;background:#fff;display:flex;align-items:center;gap:12px}
        .chat-header img{width:38px;height:38px;border-radius:50%}
        .chat-header .name{font-weight:600;font-size:0.9rem;color:#222}
        .chat-header .status{font-size:0.75rem;color:#888}
        .messages-area{flex:1;overflow-y:auto;padding:16px 20px;background:#fafafa}
        .msg-bubble{max-width:75%;padding:10px 14px;border-radius:16px;margin-bottom:8px;font-size:0.9rem;line-height:1.4}
        .msg-sent{background:#2563eb;color:#fff;margin-left:auto;border-bottom-right-radius:4px}
        .msg-received{background:#fff;color:#333;border:1px solid #e8e8e8;margin-right:auto;border-bottom-left-radius:4px}
        .msg-time{font-size:0.65rem;opacity:0.7;margin-top:3px}
        .chat-input{padding:12px 20px;border-top:1px solid #f0f0f0;background:#fff;display:flex;gap:8px;align-items:center}
        .chat-input input{flex:1;border:1px solid #e8e8e8;border-radius:24px;padding:10px 16px;font-size:0.9rem;outline:none}
        .chat-input input:focus{border-color:#2563eb}
        .chat-input .btn-send{width:40px;height:40px;border-radius:50%;border:none;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center}
        .bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #f0f0f0;display:flex;justify-content:space-around;align-items:center;padding:8px 0 12px;z-index:1000}
        .bottom-nav a{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#999;font-size:0.7rem;font-weight:500;padding:4px 12px;border-radius:12px;transition:all 0.2s}
        .bottom-nav a.active{color:#2563eb;background:#eff6ff}
        .bottom-nav a i{font-size:1.3rem;margin-bottom:2px}
    </style>
</head>
<body>
    <div class="top-header d-flex align-items-center">
        <% if (selectedUserId) { %><a href="/chat" class="me-3 text-dark"><i class="bi bi-arrow-left fs-5"></i></a><% } %>
        <h6><i class="bi bi-chat-dots me-2"></i>Messages</h6>
    </div>

    <div class="d-flex" style="height:calc(100vh - 125px)">
        <!-- Sidebar -->
        <div class="chat-sidebar <%= selectedUserId ? 'd-none d-md-block' : '' %>" style="width:100%;max-width:320px;height:100%">
            <% if (conversations.length === 0) { %>
                <div class="text-center py-5 px-3"><i class="bi bi-chat-dots" style="font-size:2rem;color:#ccc"></i><p class="text-muted mt-2" style="font-size:0.85rem">No conversations yet.<br>Visit home to start chatting!</p></div>
            <% } else { %>
                <% conversations.forEach(c => { %>
                    <a href="/chat?user=<%= c.id %>" class="conv-item <%= selectedUserId == c.id ? 'active' : '' %>">
                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(c.name) %>&size=44&background=e8e8e8&color=555" alt="">
                        <div>
                            <div class="name"><%= c.name %></div>
                            <div class="preview"><%= c.last_message ? c.last_message.substring(0,30) : 'Start a conversation' %></div>
                        </div>
                    </a>
                <% }) %>
            <% } %>
        </div>

        <!-- Chat Area -->
        <div class="d-flex flex-column flex-grow-1 <%= !selectedUserId ? 'd-none d-md-flex' : '' %>">
            <% if (selectedUser) { %>
                <div class="chat-header">
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(selectedUser.name) %>&size=38&background=e8e8e8&color=555" alt="">
                    <div>
                        <div class="name"><%= selectedUser.name %></div>
                        <div class="status"><%= selectedUser.gender %>, <%= selectedUser.age %></div>
                    </div>
                </div>
                <div class="messages-area" id="chatMsgs">
                    <% if (messages.length === 0) { %>
                        <div class="text-center py-5"><i class="bi bi-chat-dots" style="font-size:2rem;color:#ddd"></i><p class="text-muted mt-2" style="font-size:0.85rem">No messages yet. Say hello!</p></div>
                    <% } else { %>
                        <% messages.forEach(m => { %>
                            <div class="d-flex <%= m.sender_id == currentUser.id ? 'justify-content-end' : 'justify-content-start' %>">
                                <div class="msg-bubble <%= m.sender_id == currentUser.id ? 'msg-sent' : 'msg-received' %>">
                                    <div><%= m.message %></div>
                                    <div class="msg-time"><%= m.created_at %></div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
                <div class="chat-input">
                    <form method="POST" action="/chat" class="d-flex gap-2 w-100 align-items-center">
                        <input type="hidden" name="receiver_id" value="<%= selectedUserId %>">
                        <input type="text" name="message" placeholder="Type a message..." autocomplete="off">
                        <button type="submit" class="btn-send"><i class="bi bi-send-fill"></i></button>
                    </form>
                </div>
            <% } else { %>
                <div class="d-flex align-items-center justify-content-center h-100">
                    <div class="text-center"><i class="bi bi-chat-dots" style="font-size:2.5rem;color:#ddd"></i><p class="text-muted mt-2">Select a conversation</p></div>
                </div>
            <% } %>
        </div>
    </div>

    <% if (showUpgradeModal) { %>
    <div class="modal show d-block" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;border:none">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-lock-fill" style="font-size:2rem;color:#2563eb"></i>
                    <h5 class="fw-bold mt-3 mb-2">Upgrade Required</h5>
                    <p class="text-muted mb-4" style="font-size:0.9rem">Upgrade your account to unlock photo sending.</p>
                    <a href="/upgrade" class="btn btn-primary rounded-pill px-4 py-2 fw-500 w-100 mb-2">Upgrade to Premium</a>
                    <a href="/chat?user=<%= selectedUserId %>" class="btn btn-light rounded-pill w-100">Maybe Later</a>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
        <a href="/dashboard"><i class="bi bi-house-fill"></i>Home</a>
        <a href="/upgrade"><i class="bi bi-plus-circle"></i>Upgrade</a>
        <a href="/profile"><i class="bi bi-clock-history"></i>Profile</a>
        <a href="/chat" class="active"><i class="bi bi-chat-dots-fill"></i>Chats</a>
        <a href="/profile"><i class="bi bi-person-circle"></i>Account</a>
    </nav>

    <script>var c=document.getElementById('chatMsgs');if(c)c.scrollTop=c.scrollHeight;</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
