<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body{font-family:'Poppins',sans-serif;background:#f8f9fa;margin:0}
        .navbar-dating{background:linear-gradient(135deg,#e91e63,#ff5252);box-shadow:0 2px 15px rgba(233,30,99,0.3)}
        .navbar-dating .navbar-brand,.navbar-dating .nav-link{color:white!important;font-weight:600}
        .chat-container{height:calc(100vh - 56px)}
        .chat-sidebar{background:white;border-right:1px solid #eee;overflow-y:auto}
        .chat-sidebar .conv-item{padding:15px;border-bottom:1px solid #f0f0f0;transition:background 0.2s;cursor:pointer;text-decoration:none;display:flex;align-items:center;color:inherit}
        .chat-sidebar .conv-item:hover,.chat-sidebar .conv-item.active{background:#fce4ec}
        .chat-bubble{max-width:75%;padding:12px 18px;border-radius:20px;margin-bottom:10px}
        .chat-sent{background:linear-gradient(135deg,#e91e63,#ff5252);color:white;margin-left:auto;border-bottom-right-radius:5px}
        .chat-received{background:#f0f0f0;color:#333;margin-right:auto;border-bottom-left-radius:5px}
        .chat-time{font-size:0.7rem;opacity:0.7;margin-top:4px}
        .btn-send{background:linear-gradient(135deg,#e91e63,#ff5252);border:none;color:white;border-radius:50%;width:45px;height:45px}
        .btn-send:hover{color:white;transform:scale(1.05)}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dating sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard"><i class="bi bi-heart-fill me-2"></i>LoveConnect</a>
            <div class="d-flex">
                <a class="nav-link text-white me-3" href="/dashboard"><i class="bi bi-grid-fill"></i></a>
                <a class="nav-link text-white me-3" href="/chat"><i class="bi bi-chat-heart-fill"></i></a>
                <a class="nav-link text-white" href="/logout"><i class="bi bi-box-arrow-right"></i></a>
            </div>
        </div>
    </nav>
    <div class="container-fluid p-0 chat-container">
        <div class="row g-0 h-100">
            <div class="col-md-4 col-lg-3 chat-sidebar <%= selectedUserId ? 'd-none d-md-block' : '' %>" style="height:100%">
                <div class="p-3 border-bottom"><h5 class="fw-bold mb-0"><i class="bi bi-chat-heart-fill me-2"></i>Messages</h5></div>
                <% if (conversations.length === 0) { %>
                    <div class="text-center py-5 px-3"><i class="bi bi-chat-dots fs-1 text-muted"></i><p class="text-muted mt-2">No conversations yet.<br>Visit dashboard to start chatting!</p></div>
                <% } else { %>
                    <% conversations.forEach(c => { %>
                        <a href="/chat?user=<%= c.id %>" class="conv-item <%= selectedUserId == c.id ? 'active' : '' %>">
                            <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(c.name) %>&size=45&background=e91e63&color=fff" class="rounded-circle me-3" style="width:45px;height:45px">
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="mb-0 fw-600"><%= c.name %></h6>
                                <small class="text-muted text-truncate d-block"><%= c.last_message ? c.last_message.substring(0,30) : '' %></small>
                            </div>
                        </a>
                    <% }) %>
                <% } %>
            </div>
            <div class="col-md-8 col-lg-9 d-flex flex-column <%= !selectedUserId ? 'd-none d-md-flex' : '' %>" style="height:100%">
                <% if (selectedUser) { %>
                    <div class="p-3 border-bottom bg-white d-flex align-items-center">
                        <a href="/chat" class="btn btn-light btn-sm rounded-circle me-2 d-md-none"><i class="bi bi-arrow-left"></i></a>
                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(selectedUser.name) %>&size=40&background=e91e63&color=fff" class="rounded-circle me-3" style="width:40px;height:40px">
                        <div><h6 class="mb-0 fw-bold"><%= selectedUser.name %></h6><small class="text-muted"><%= selectedUser.gender %>, <%= selectedUser.age %></small></div>
                    </div>
                    <div class="flex-grow-1 p-3" style="overflow-y:auto;background:#f8f9fa" id="chatMsgs">
                        <% if (messages.length === 0) { %>
                            <div class="text-center py-5"><i class="bi bi-chat-dots fs-1 text-muted"></i><p class="text-muted mt-2">No messages yet. Say hello!</p></div>
                        <% } else { %>
                            <% messages.forEach(m => { %>
                                <div class="d-flex <%= m.sender_id == currentUser.id ? 'justify-content-end' : 'justify-content-start' %> mb-2">
                                    <div class="chat-bubble <%= m.sender_id == currentUser.id ? 'chat-sent' : 'chat-received' %>">
                                        <p class="mb-0"><%= m.message %></p>
                                        <div class="chat-time"><%= m.created_at %></div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                    <div class="p-3 border-top bg-white">
                        <form method="POST" action="/chat" class="d-flex gap-2">
                            <input type="hidden" name="receiver_id" value="<%= selectedUserId %>">
                            <button type="button" class="btn btn-light rounded-circle" onclick="alert('Upgrade to Premium to send photos!')"><i class="bi bi-image"></i></button>
                            <input type="text" name="message" class="form-control rounded-pill" placeholder="Type a message..." autocomplete="off">
                            <button type="submit" class="btn btn-send"><i class="bi bi-send-fill"></i></button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="text-center"><i class="bi bi-chat-heart fs-1 text-muted"></i><h5 class="mt-3 text-muted">Select a conversation</h5></div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <% if (showUpgradeModal) { %>
    <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px;border:none">
                <div class="modal-body text-center p-5">
                    <i class="bi bi-lock-fill fs-1" style="color:#e91e63"></i>
                    <h4 class="fw-bold mt-3 mb-3">Upgrade Required</h4>
                    <p class="text-muted mb-4">Upgrade your account to unlock photo sending. Premium members can send and receive photos in chat!</p>
                    <a href="/upgrade" class="btn btn-danger rounded-pill px-4 py-2 fw-bold"><i class="bi bi-star-fill me-2"></i>Upgrade to Premium</a>
                    <br><a href="/chat?user=<%= selectedUserId %>" class="btn btn-light mt-2">Maybe Later</a>
                </div>
            </div>
        </div>
    </div>
    <% } %>
    <script>var c=document.getElementById('chatMsgs');if(c)c.scrollTop=c.scrollHeight;</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
