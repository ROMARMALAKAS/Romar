<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - LoveConnect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body{font-family:'Poppins',sans-serif;background:#f8f9fa}
        .navbar-dating{background:linear-gradient(135deg,#e91e63,#ff5252);box-shadow:0 2px 15px rgba(233,30,99,0.3)}
        .navbar-dating .navbar-brand,.navbar-dating .nav-link{color:white!important;font-weight:600}
        .card-profile{border:none;border-radius:20px;box-shadow:0 5px 25px rgba(0,0,0,0.08);transition:all 0.3s;overflow:hidden}
        .card-profile:hover{transform:translateY(-5px);box-shadow:0 10px 40px rgba(0,0,0,0.12)}
        .card-profile img{width:100%;height:220px;object-fit:cover}
        .badge-premium{background:linear-gradient(135deg,#f5af19,#f12711);color:white;padding:5px 12px;border-radius:15px;font-size:0.75rem}
        .badge-free{background:#e0e0e0;color:#666;padding:5px 12px;border-radius:15px;font-size:0.75rem}
        .distance-badge{background:#fce4ec;color:#e91e63;padding:4px 10px;border-radius:10px;font-size:0.8rem;font-weight:500}
        .btn-msg{background:linear-gradient(135deg,#e91e63,#ff5252);border:none;color:white;border-radius:25px;font-weight:600;padding:8px 20px;transition:all 0.3s}
        .btn-msg:hover{transform:translateY(-2px);box-shadow:0 4px 15px rgba(233,30,99,0.3);color:white}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dating sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/dashboard"><i class="bi bi-heart-fill me-2"></i>LoveConnect</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <i class="bi bi-list text-white fs-4"></i>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-grid-fill me-1"></i>Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/profile"><i class="bi bi-person-fill me-1"></i>Profile</a></li>
                    <li class="nav-item"><a class="nav-link" href="/chat"><i class="bi bi-chat-heart-fill me-1"></i>Chat</a></li>
                    <li class="nav-item"><a class="nav-link" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div><h3 class="fw-bold mb-1">Discover People</h3><p class="text-muted mb-0">Find someone special near you</p></div>
            <span class="<%= currentUser.account_type === 'premium' ? 'badge-premium' : 'badge-free' %>">
                <i class="bi <%= currentUser.account_type === 'premium' ? 'bi-star-fill' : 'bi-person' %> me-1"></i><%= currentUser.account_type === 'premium' ? 'Premium' : 'Free' %>
            </span>
        </div>
        <% if (users.length === 0) { %>
            <div class="text-center py-5"><i class="bi bi-people fs-1 text-muted"></i><h5 class="mt-3 text-muted">No users found yet</h5></div>
        <% } else { %>
            <div class="row g-4">
                <% users.forEach(u => { %>
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card card-profile h-100">
                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&size=250&background=e91e63&color=fff&bold=true" alt="<%= u.name %>">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0"><%= u.name %>, <%= u.age %></h5>
                                <% if (u.account_type === 'premium') { %><i class="bi bi-patch-check-fill text-warning"></i><% } %>
                            </div>
                            <p class="text-muted small mb-2"><i class="bi bi-gender-ambiguous me-1"></i><%= u.gender.charAt(0).toUpperCase() + u.gender.slice(1) %></p>
                            <p class="small text-muted mb-2"><%= u.bio ? u.bio.substring(0, 80) : 'No bio yet' %><%= u.bio && u.bio.length > 80 ? '...' : '' %></p>
                            <% if (u.distance) { %>
                                <span class="distance-badge"><i class="bi bi-geo-alt me-1"></i><%= u.distance %> km away</span>
                            <% } else { %>
                                <span class="distance-badge"><i class="bi bi-geo-alt me-1"></i>Nearby</span>
                            <% } %>
                        </div>
                        <div class="card-footer bg-white border-0 p-3 pt-0">
                            <a href="/chat?user=<%= u.id %>" class="btn btn-msg w-100"><i class="bi bi-chat-heart me-1"></i>Message</a>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        <% } %>
    </div>
    <script>
        if(navigator.geolocation){navigator.geolocation.getCurrentPosition(function(p){fetch('/update-location',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({latitude:p.coords.latitude,longitude:p.coords.longitude})})})}
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
